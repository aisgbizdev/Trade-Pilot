# Example environment configuration for the TradePilot API server.
# Copy to .env locally and fill in real values — never commit .env or
# paste real secrets into .replit (see git history: this has happened
# more than once with Firebase, Apple, TikTok, and Facebook credentials).
# In production, every *_SECRET / *_PRIVATE_KEY value below must be set
# as a platform Secret, never as a plain config value.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Sessions / general -------------------------------------------------
# Origin the OAuth redirect_uri is built from. Must match a registered
# provider redirect URI (<PUBLIC_BASE_URL>/api/auth/{google,facebook,tiktok}/callback).
PUBLIC_BASE_URL=http://localhost:5173

# --- Google OAuth (web + native) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist of OAuth client ids accepted as the `aud` of a
# native-app Google ID token (Android + iOS + web).
GOOGLE_NATIVE_ALLOWED_CLIENT_IDS=

# --- Sign in with Apple (native only) ------------------------------------
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The real .p8 private key contents, with literal \n line breaks (or real
# newlines — both are accepted). NEVER commit a real value here.
APPLE_PRIVATE_KEY=
APPLE_ALLOWED_CLIENT_IDS=

# --- Facebook Login (web + mobile) ---------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- TikTok Login Kit (web + mobile) -------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Mobile OAuth browser flow (Flutter) ---------------------------------
# Exact-match allowlist of custom-scheme redirect URIs the mobile app may
# request in GET /auth/{facebook,tiktok}/mobile/start. Comma-separated if
# more than one. No prefix/wildcard matching is ever performed.
MOBILE_OAUTH_REDIRECT_URIS=id.tradepilot.app://auth/callback

# --- Firebase Admin SDK (native push / FCM) ------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
