modules = ["nodejs-24", "python-3.11", "java-graalvm22.3", "dart-3.10", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-trading-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "api-server-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ai-trading-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/ai-trading run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/e2e run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
OPENAI_MODEL = "gpt-4o"
OPENAI_MODEL_FAST_INTRADAY = "gpt-4o-mini"
VAPID_PUBLIC_KEY = "BCy2eUxjgQhGCK-Mti151i1Imkl2A79b9WUeb5I8huNGKZyO6VjhwgzoxW5vhR4xCZs350A82KvxxLYLb5oYaHs"
VAPID_EMAIL = "mailto:admin@aitradingassistant.app"
# Google OAuth (login/register). The client id is not secret — it is sent
# to the browser during the consent redirect. GOOGLE_CLIENT_SECRET must be
# set as a Replit Secret (prod) / in .env (local), never here.
GOOGLE_CLIENT_ID = "929958103345-cbf424vgelrer7nkrr81l4iptsikuc1u.apps.googleusercontent.com"
# Origin the OAuth redirect_uri is built from; must match a registered
# redirect URI (<PUBLIC_BASE_URL>/api/auth/google/callback). Prod value —
# local dev overrides this to http://localhost:5173 via .env.
PUBLIC_BASE_URL = "https://tradepilot.id"
GOOGLE_NATIVE_ALLOWED_CLIENT_IDS = "929958103345-pbkqoipkvjinth022lvt50822flokdmf.apps.googleusercontent.com,929958103345-cieflfi7p13t6dnhqt8j0qfif9iia57g.apps.googleusercontent.com,929958103345-cbf424vgelrer7nkrr81l4iptsikuc1u.apps.googleusercontent.com"
FIREBASE_PROJECT_ID = "trade-pilot-newsmaker23"
FIREBASE_TYPE = "service_account"
# Firebase Admin SDK (native push / FCM). FIREBASE_PRIVATE_KEY is a real
# service-account credential — it must be set as a Replit Secret (prod) /
# in .env (local), never here. (A previous value was found committed in
# this file and must be treated as compromised — rotate it in the Firebase
# console: Project Settings > Service Accounts > Generate new private key,
# then delete the old key.)
FIREBASE_CLIENT_EMAIL = "firebase-adminsdk-fbsvc@trade-pilot-newsmaker23.iam.gserviceaccount.com"
FIREBASE_CLIENT_ID = "103364585069863090084"
FIREBASE_AUTH_URI = "https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI = "https://oauth2.googleapis.com/token"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL = "https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_AUTH_X509_CERT_URL = "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40trade-pilot-newsmaker23.iam.gserviceaccount.com"
FIREBASE_UNIVERSE_DOMAIN = "googleapis.com"
# Sign in with Apple. APPLE_PRIVATE_KEY is the real `.p8` key — it must be
# set as a Replit Secret (prod) / in .env (local), NEVER in this file. A
# real key has already been committed here twice (see git history around
# 2026-09-17) — do not paste another one here even temporarily; use the
# Secrets panel instead.
APPLE_TEAM_ID = "6P8964KJMG"
APPLE_KEY_ID = "2TNDYD63SR"
APPLE_ALLOWED_CLIENT_IDS = "id.tradepilot.app"
# TikTok Login Kit (login/register). TIKTOK_CLIENT_KEY is public (like
# GOOGLE_CLIENT_ID above) and can go here once issued. TIKTOK_CLIENT_SECRET
# is a real secret — it must be set as a Replit Secret (prod) / in .env
# (local), NEVER in this file. Not set yet; POST/GET /auth/tiktok returns
# 503 until both are configured.
# TIKTOK_CLIENT_KEY = ""

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-830a0fc3-9cdc-4962-956a-29b9bdb6c602"

[[ports]]
localPort = 4380
externalPort = 3002

[[ports]]
localPort = 4381
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 20853
externalPort = 3000

[[ports]]
localPort = 29911
externalPort = 5000

[[ports]]
localPort = 29912
externalPort = 5173
